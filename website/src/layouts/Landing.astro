---
import '@fontsource-variable/dm-sans';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import '../styles/theme.css';
import '../styles/landing.css';
import LegalLinks from '../components/LegalLinks.astro';

interface Props {
	title: string;
	description: string;
	version: string;
}

const { title, description, version } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
const repo = 'https://github.com/DamienReichhart/MarketForge';
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
		<link rel="sitemap" href={`${base}/sitemap-index.xml`} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content="MarketForge" />
		<meta property="og:image" content={new URL(`${base}/og-image.png`, Astro.site)} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="MarketForge: synthetic market data for training AI trading models and testing backtesters" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={new URL(`${base}/og-image.png`, Astro.site)} />
		<meta name="theme-color" content="#12161b" />
		<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
		<meta name="color-scheme" content="dark light" />
		<script is:inline>
			// Same key as the docs' theme picker, so both halves of the site agree.
			(() => {
				let stored = '';
				try {
					stored = localStorage.getItem('starlight-theme') || '';
				} catch {}
				const light = stored ? stored === 'light' : matchMedia('(prefers-color-scheme: light)').matches;
				document.documentElement.dataset.theme = light ? 'light' : 'dark';
			})();
		</script>
	</head>
	<body class="mf-landing">
		<a class="mf-skip" href="#main">Skip to content</a>
		<header class="mf-nav">
			<div class="mf-wrap mf-nav-inner">
				<a class="mf-brand" href={`${base}/`}>
					<img src={`${base}/favicon.svg`} alt="" width="24" height="24" />
					<span>MarketForge</span>
				</a>
				<nav aria-label="Main">
					<ul>
						<li><a href={`${base}/docs/`}>Docs</a></li>
						<li class="mf-hide-sm"><a href={`${base}/playground/`}>Playground</a></li>
						<li class="mf-hide-sm"><a href={`${base}/docs/use-cases/machine-learning/`}>Use cases</a></li>
						<li class="mf-hide-sm"><a href={`${base}/changelog/`}>Changelog</a></li>
						<li>
							<a class="mf-nav-gh" href={repo} aria-label="MarketForge on GitHub">
								<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
								<span class="mf-hide-sm">GitHub</span>
							</a>
						</li>
						<li>
							<button class="mf-theme" type="button" aria-label="Switch between dark and light theme">
								<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 1 0 0 18V3Z"></path><circle cx="12" cy="12" r="8.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle></svg>
							</button>
						</li>
					</ul>
				</nav>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="mf-footer">
			<div class="mf-wrap">
				<div class="mf-footer-cols">
					<div>
						<a class="mf-brand" href={`${base}/`}>
							<img src={`${base}/favicon.svg`} alt="" width="22" height="22" />
							<span>MarketForge</span>
						</a>
						<p>Synthetic market data for training AI trading models and testing backtesters. Free and open source.</p>
						<p class="mf-footer-version">Latest release <a href={`${base}/changelog/`}>v{version}</a></p>
					</div>
					<div>
						<h2>Documentation</h2>
						<ul>
							<li><a href={`${base}/docs/quick-start/`}>Quick start</a></li>
							<li><a href={`${base}/docs/guides/cli/`}>Command line</a></li>
							<li><a href={`${base}/docs/guides/python-api/`}>Python API</a></li>
							<li><a href={`${base}/docs/reference/model/`}>The model</a></li>
						</ul>
					</div>
					<div>
						<h2>Use cases</h2>
						<ul>
							<li><a href={`${base}/docs/use-cases/machine-learning/`}>Training ML models</a></li>
							<li><a href={`${base}/docs/use-cases/backtesting/`}>Backtesting</a></li>
							<li><a href={`${base}/docs/use-cases/stress-testing/`}>Stress testing</a></li>
							<li><a href={`${base}/docs/limits/`}>What it is not</a></li>
						</ul>
					</div>
					<div>
						<h2>Project</h2>
						<ul>
							<li><a href={repo}>GitHub</a></li>
							<li><a href="https://pypi.org/project/marketforge/">PyPI</a></li>
							<li><a href={`${base}/changelog/`}>Changelog</a></li>
							<li><a href={`${base}/docs/contributing/`}>Contributing</a></li>
						</ul>
					</div>
				</div>
				<p class="mf-disclaimer">
					All data MarketForge produces is synthetic. It is not the price history of any real instrument,
					and nothing on this site is financial advice.
				</p>
				<LegalLinks />
			</div>
		</footer>

		<script>
			const button = document.querySelector<HTMLButtonElement>('.mf-theme');
			button?.addEventListener('click', () => {
				const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
				document.documentElement.dataset.theme = next;
				try {
					localStorage.setItem('starlight-theme', next);
				} catch {}
			});
		</script>
	</body>
</html>
