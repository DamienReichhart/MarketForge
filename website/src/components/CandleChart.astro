---
/**
 * A candlestick chart of real MarketForge output, rendered to SVG at build
 * time by src/lib/candle-chart.ts (the playground draws the same chart in the
 * browser): candles, volume, and the hidden regime of every candle as shaded
 * bands, with a readout of the candle under the pointer.
 */
import { chartMarkup, type Candle } from '../lib/candle-chart';
import sample from '../samples/hero-sample.json';
import '../styles/candle-chart.css';

const markup = chartMarkup(sample.candles as Candle[], {
	instrument: sample.instrument,
	meta: `${sample.timeframe} · ${sample.market} · seed ${sample.seed}`,
	label: `${sample.instrument} ${sample.timeframe} candles generated by MarketForge with seed ${sample.seed}, shaded by market regime`,
	command: sample.command,
});
---

<Fragment set:html={markup} />

<script>
	import { attachReadout } from '../lib/candle-chart';

	for (const figure of document.querySelectorAll<HTMLElement>('.mf-chart')) attachReadout(figure);
</script>
