---
/**
 * A candlestick chart of real MarketForge output, rendered to SVG at build
 * time: candles, volume, and the hidden regime of every candle as shaded
 * bands. A few lines of script add a readout of the candle under the pointer.
 */
import sample from '../samples/hero-sample.json';

type Candle = [number, number, number, number, number, number, number, string];
const candles = sample.candles as Candle[];

const W = 1200;
const H = 440;
const priceTop = 16;
const priceBottom = 340;
const volTop = 362;
const volBottom = 432;

const lows = candles.map((c) => c[3]);
const highs = candles.map((c) => c[2]);
const pad = (Math.max(...highs) - Math.min(...lows)) * 0.04;
const min = Math.min(...lows) - pad;
const max = Math.max(...highs) + pad;
const maxVol = Math.max(...candles.map((c) => c[5]));

const step = W / candles.length;
const body = Math.max(1, step * 0.62);
const y = (price: number) => priceTop + ((max - price) / (max - min)) * (priceBottom - priceTop);
const x = (i: number) => i * step + step / 2;

// Regime runs, for the shaded bands and the legend.
const runs: { regime: string; from: number; to: number }[] = [];
candles.forEach((c, i) => {
	const last = runs.at(-1);
	if (last && last.regime === c[7]) last.to = i;
	else runs.push({ regime: c[7], from: i, to: i });
});

// Price gridlines at round numbers.
const span = max - min;
const rawStep = span / 5;
const magnitude = 10 ** Math.floor(Math.log10(rawStep));
const gridStep = [1, 2, 2.5, 5, 10].map((m) => m * magnitude).find((s) => s >= rawStep) ?? rawStep;
const gridPrices: number[] = [];
for (let p = Math.ceil(min / gridStep) * gridStep; p <= max; p += gridStep) gridPrices.push(p);

// One time label per UTC day.
const dayTicks = candles
	.map((c, i) => ({ i, d: new Date(c[0] * 1000) }))
	.filter(({ d }) => d.getUTCHours() === 0)
	.map(({ i, d }) => ({
		left: (x(i) / W) * 100,
		label: d.toLocaleDateString('en-US', { month: 'short', day: '2-digit', timeZone: 'UTC' }),
	}));

const fmt = (n: number) => n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const regimeLabel: Record<string, string> = {
	trend_up: 'Trend up',
	trend_down: 'Trend down',
	range: 'Range',
	high_volatility: 'High volatility',
	crash: 'Crash',
};
const last = candles.at(-1)!;
---

<figure class="mf-chart" data-candles={JSON.stringify(candles)}>
	<figcaption class="mf-chart-bar">
		<div class="mf-chart-id">
			<span class="mf-chart-symbol">{sample.instrument}</span>
			<span class="mf-chart-meta">{sample.timeframe} · {sample.market} · seed {sample.seed}</span>
		</div>
		<dl class="mf-chart-readout" aria-live="polite">
			<div><dt>O</dt><dd data-k="1">{fmt(last[1])}</dd></div>
			<div><dt>H</dt><dd data-k="2">{fmt(last[2])}</dd></div>
			<div><dt>L</dt><dd data-k="3">{fmt(last[3])}</dd></div>
			<div><dt>C</dt><dd data-k="4">{fmt(last[4])}</dd></div>
			<div class="mf-hide-sm"><dt>Spread</dt><dd data-k="6">{last[6].toFixed(4)}</dd></div>
			<div><dt>Regime</dt><dd data-k="7" class={`mf-regime-tag r-${last[7]}`}>{regimeLabel[last[7]]}</dd></div>
		</dl>
	</figcaption>

	<div class="mf-chart-plot">
		<svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img" aria-label={`${sample.instrument} ${sample.timeframe} candles generated by MarketForge with seed ${sample.seed}, shaded by market regime`}>
			{runs.map((r) => (
				<rect class={`band r-${r.regime}`} x={r.from * step} y="0" width={(r.to - r.from + 1) * step} height={H} />
			))}
			{gridPrices.map((p) => <line class="grid" x1="0" x2={W} y1={y(p)} y2={y(p)} />)}
			<line class="grid" x1="0" x2={W} y1={volTop - 10} y2={volTop - 10} />
			{candles.map((c, i) => {
				const up = c[4] >= c[1];
				const top = y(Math.max(c[1], c[4]));
				const h = Math.max(1, Math.abs(y(c[1]) - y(c[4])));
				const vh = (c[5] / maxVol) * (volBottom - volTop);
				return (
					<g class={up ? 'up' : 'down'}>
						<line class="wick" x1={x(i)} x2={x(i)} y1={y(c[2])} y2={y(c[3])} />
						<rect class="body" x={x(i) - body / 2} y={top} width={body} height={h} />
						<rect class="vol" x={x(i) - body / 2} y={volBottom - vh} width={body} height={vh} />
					</g>
				);
			})}
			<line class="cursor" x1="0" x2="0" y1="0" y2={H} />
		</svg>
		<div class="mf-axis-y" aria-hidden="true">
			{gridPrices.map((p) => <span style={`top:${(y(p) / H) * 100}%`}>{fmt(p).replace(/\.00$/, '')}</span>)}
		</div>
		<div class="mf-axis-x" aria-hidden="true">
			{dayTicks.map((t, n) => <span class={n % 2 ? 'mf-hide-sm' : ''} style={`left:${t.left}%`}>{t.label}</span>)}
		</div>
	</div>

	<div class="mf-chart-foot">
		<ul class="mf-legend" aria-label="Regimes">
			{Object.entries(regimeLabel).map(([key, label]) => <li><i class={`r-${key}`}></i>{label}</li>)}
		</ul>
		<code class="mf-chart-cmd">$ {sample.command}</code>
	</div>
</figure>

<script>
	const labels: Record<string, string> = {
		trend_up: 'Trend up',
		trend_down: 'Trend down',
		range: 'Range',
		high_volatility: 'High volatility',
		crash: 'Crash',
	};
	const fmt = (n: number) => n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
	for (const fig of document.querySelectorAll<HTMLElement>('.mf-chart')) {
		const candles = JSON.parse(fig.dataset.candles ?? '[]') as (number | string)[][];
		const svg = fig.querySelector('svg')!;
		const cursor = fig.querySelector<SVGLineElement>('.cursor')!;
		const cells = fig.querySelectorAll<HTMLElement>('[data-k]');
		const show = (i: number) => {
			const c = candles[i];
			for (const cell of cells) {
				const k = Number(cell.dataset.k);
				if (k === 7) {
					cell.textContent = labels[c[7] as string];
					cell.className = `mf-regime-tag r-${c[7]}`;
				} else cell.textContent = k === 6 ? (c[6] as number).toFixed(4) : fmt(c[k] as number);
			}
		};
		const move = (event: PointerEvent) => {
			const box = svg.getBoundingClientRect();
			const ratio = Math.min(0.9999, Math.max(0, (event.clientX - box.left) / box.width));
			const i = Math.floor(ratio * candles.length);
			const cx = ((i + 0.5) / candles.length) * 1200;
			cursor.setAttribute('x1', String(cx));
			cursor.setAttribute('x2', String(cx));
			cursor.classList.add('on');
			show(i);
		};
		svg.addEventListener('pointermove', move);
		svg.addEventListener('pointerleave', () => {
			cursor.classList.remove('on');
			show(candles.length - 1);
		});
	}
</script>

<style>
	.mf-chart {
		margin: 0;
		border: 1px solid var(--mf-line-strong);
		border-radius: 6px;
		background: var(--mf-panel);
		overflow: hidden;
	}
	.mf-chart-bar {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		justify-content: space-between;
		align-items: center;
		padding: 0.7rem 1rem;
		border-bottom: 1px solid var(--mf-line);
		font-family: var(--sl-font-mono);
		font-size: 0.75rem;
	}
	.mf-chart-symbol {
		font-weight: 700;
		color: var(--mf-text);
		margin-right: 0.6rem;
	}
	.mf-chart-meta {
		color: var(--mf-muted);
	}
	.mf-chart-readout {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		margin: 0;
		font-variant-numeric: tabular-nums;
	}
	.mf-chart-readout div {
		display: flex;
		gap: 0.35rem;
	}
	.mf-chart-readout dt {
		color: var(--mf-muted);
	}
	.mf-chart-readout dd {
		margin: 0;
		color: var(--mf-text);
	}
	.mf-chart-plot {
		position: relative;
		padding-right: 4.5rem;
		padding-bottom: 1.6rem;
	}
	svg {
		display: block;
		width: 100%;
		height: clamp(15rem, 34vw, 27rem);
		touch-action: pan-y;
		cursor: crosshair;
	}
	.band {
		fill: transparent;
	}
	.band.r-trend_up {
		fill: var(--mf-regime-trend-up);
	}
	.band.r-trend_down {
		fill: var(--mf-regime-trend-down);
	}
	.band.r-high_volatility {
		fill: var(--mf-regime-high-vol);
	}
	.band.r-crash {
		fill: var(--mf-regime-crash);
	}
	.grid {
		stroke: var(--mf-line);
		stroke-width: 1;
		vector-effect: non-scaling-stroke;
	}
	.wick {
		stroke-width: 1;
		vector-effect: non-scaling-stroke;
	}
	.up .wick {
		stroke: var(--mf-up);
	}
	.down .wick {
		stroke: var(--mf-down);
	}
	.up .body {
		fill: var(--mf-up);
	}
	.down .body {
		fill: var(--mf-down);
	}
	.vol {
		opacity: 0.32;
	}
	.up .vol {
		fill: var(--mf-up);
	}
	.down .vol {
		fill: var(--mf-down);
	}
	.cursor {
		stroke: var(--mf-muted);
		stroke-dasharray: 3 3;
		vector-effect: non-scaling-stroke;
		opacity: 0;
	}
	.cursor.on {
		opacity: 1;
	}
	.mf-axis-y {
		position: absolute;
		top: 0;
		right: 0;
		width: 4.5rem;
		bottom: 1.6rem;
		font-family: var(--sl-font-mono);
		font-size: 0.6875rem;
		color: var(--mf-muted);
		font-variant-numeric: tabular-nums;
	}
	.mf-axis-y span {
		position: absolute;
		left: 0.6rem;
		transform: translateY(-50%);
	}
	.mf-axis-x {
		position: absolute;
		left: 0;
		right: 4.5rem;
		bottom: 0;
		height: 1.6rem;
		font-family: var(--sl-font-mono);
		font-size: 0.6875rem;
		color: var(--mf-muted);
	}
	.mf-axis-x span {
		position: absolute;
		top: 0.35rem;
		transform: translateX(-50%);
		white-space: nowrap;
	}
	.mf-axis-x span:first-child {
		transform: none;
	}
	.mf-chart-foot {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
		justify-content: space-between;
		align-items: center;
		padding: 0.7rem 1rem;
		border-top: 1px solid var(--mf-line);
		font-size: 0.75rem;
	}
	.mf-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		list-style: none;
		margin: 0;
		padding: 0;
		color: var(--mf-muted);
	}
	.mf-legend li {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}
	.mf-legend i {
		display: inline-block;
		width: 0.75rem;
		height: 0.75rem;
		border: 1px solid var(--mf-line-strong);
		border-radius: 2px;
	}
	.mf-legend i.r-trend_up {
		background: var(--mf-regime-trend-up);
		border-color: color-mix(in srgb, var(--mf-up) 45%, transparent);
	}
	.mf-legend i.r-trend_down {
		background: var(--mf-regime-trend-down);
		border-color: color-mix(in srgb, var(--mf-down) 45%, transparent);
	}
	.mf-legend i.r-high_volatility {
		background: var(--mf-regime-high-vol);
		border-color: color-mix(in srgb, var(--sl-color-accent) 55%, transparent);
	}
	.mf-legend i.r-crash {
		background: var(--mf-regime-crash);
		border-color: var(--mf-down);
	}
	.mf-chart-cmd {
		font-family: var(--sl-font-mono);
		color: var(--mf-muted);
		font-size: 0.6875rem;
		overflow-x: auto;
		white-space: nowrap;
		max-width: 100%;
	}
	:global(.mf-regime-tag) {
		font-weight: 600;
	}
	:global(.mf-regime-tag.r-trend_up) {
		color: var(--mf-up);
	}
	:global(.mf-regime-tag.r-trend_down),
	:global(.mf-regime-tag.r-crash) {
		color: var(--mf-down);
	}
	:global(.mf-regime-tag.r-high_volatility) {
		color: var(--sl-color-accent);
	}
	@media (max-width: 40rem) {
		.mf-hide-sm {
			display: none;
		}
		.mf-chart-plot {
			padding-right: 3.6rem;
		}
		.mf-axis-y {
			width: 3.6rem;
		}
		.mf-axis-x {
			right: 3.6rem;
		}
	}
</style>
