---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import CandleChart from '../components/CandleChart.astro';
import Landing from '../layouts/Landing.astro';
import sample from '../samples/hero-sample.json';

// The version on the page is the one in pyproject.toml, which on main is the
// latest release: the site is deployed from main only.
const pyproject = readFileSync(resolve(process.cwd(), '..', 'pyproject.toml'), 'utf8');
const version = /^version\s*=\s*"([^"]+)"/m.exec(pyproject)?.[1] ?? '';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docs = (path = '') => `${base}/docs/${path}`;

// A real excerpt of the sample: the hours around the crash.
const crashAt = sample.candles.findIndex((c) => c[7] === 'crash');
const excerpt = sample.candles.slice(crashAt - 3, crashAt + 3);
const iso = (t: number) => new Date(t * 1000).toISOString().replace(':00.000Z', 'Z');
const validationLines = sample.validation.summary.split('\n');
---

<Landing
	title="MarketForge: synthetic market data for AI trading models and backtesters"
	description="Open-source generator of realistic OHLCV data: 208 crypto, forex and stock instruments, real trading calendars, labelled market regimes, bid-ask spreads, reproducible from a seed. Train AI trading models and stress-test backtesters."
	version={version}
>
	<section class="mf-hero">
		<div class="mf-wrap">
			<p class="mf-eyebrow">
				<span class="mf-dot" aria-hidden="true"></span>
				Open source · Python · Apache-2.0 · v{version}
			</p>
			<h1>Training data for trading models.<br /><span>Generated, labelled, reproducible.</span></h1>
			<p class="mf-lede">
				MarketForge simulates 208 crypto, forex and US stock instruments minute by minute, on each market's
				real trading calendar. Every candle can carry the hidden market regime that produced it and a
				realistic bid-ask spread, and every dataset comes back from its seed and version. Use it to train and
				pre-train AI trading models, and to find out what breaks your backtester before real money does.
			</p>
			<div class="mf-cta">
				<a class="mf-btn mf-btn-primary" href={docs('quick-start/')}>Get started</a>
				<a class="mf-btn" href={`${base}/playground/`}>Try it in your browser</a>
				<a class="mf-btn" href={docs()}>Documentation</a>
				<div class="mf-install">
					<code>pip install marketforge</code>
					<button type="button" data-copy="pip install marketforge" aria-label="Copy the install command">Copy</button>
				</div>
			</div>
		</div>
		<div class="mf-wrap mf-hero-chart">
			<CandleChart />
			<p class="mf-caption">
				Real output, not a mock-up: ten days of {sample.instrument} from seed {sample.seed}, generated by
				MarketForge {sample.version} when this site was built. The shading is the regime label MarketForge wrote
				next to each candle. Hover the chart to read it.
			</p>
		</div>
	</section>

	<section class="mf-stats" aria-label="Key figures">
		<div class="mf-wrap">
			<dl>
				<div><dt>Instruments</dt><dd>208</dd><span>53 crypto · 81 forex · 74 stocks</span></div>
				<div><dt>Timeframes</dt><dd>m1 → W1</dd><span>17 aligned to each market's clock</span></div>
				<div><dt>Regime labels</dt><dd>5</dd><span>trend up/down, range, high vol, crash</span></div>
				<div><dt>Reproducible</dt><dd>per version</dd><span>same seed and version, same candles</span></div>
				<div><dt>One year of EURUSD</dt><dd>~2 s</dd><span>all timeframes, on a laptop</span></div>
			</dl>
		</div>
	</section>

	<section class="mf-section" id="use-cases">
		<div class="mf-wrap">
			<header class="mf-section-head">
				<p class="mf-kicker">Built for</p>
				<h2>The parts of quant work where real data runs out</h2>
				<p>Real history is finite, expensive, unlabelled and leaks into every model you fit on it. Synthetic data doesn't replace it. It covers what real data can't.</p>
			</header>
			<div class="mf-grid-3">
				<a class="mf-card" href={docs('use-cases/machine-learning/')}>
					<span class="mf-card-index">01</span>
					<h3>Training AI trading models</h3>
					<p>Unlimited, labelled sequences for pre-training, data augmentation and architecture search.</p>
					<ul>
						<li>Ground-truth regime for every candle: supervised targets real data can't give you</li>
						<li>A seed per split: train, validation and test never overlap</li>
						<li>Multi-asset panels with realistic correlation and tail dependence</li>
					</ul>
					<span class="mf-card-link">ML guide →</span>
				</a>
				<a class="mf-card" href={docs('use-cases/backtesting/')}>
					<span class="mf-card-index">02</span>
					<h3>Testing backtesters</h3>
					<p>Data that behaves like a real feed, so the bugs show up in testing rather than in production.</p>
					<ul>
						<li>NYSE sessions, holidays, early closes and DST; forex weeks; 24/7 crypto</li>
						<li>Overnight and weekend gaps, mid prices plus a bid-ask spread</li>
						<li>Arbitrage-free forex crosses: EURJPY = EURUSD × USDJPY</li>
					</ul>
					<span class="mf-card-link">Backtesting guide →</span>
				</a>
				<a class="mf-card" href={docs('use-cases/stress-testing/')}>
					<span class="mf-card-index">03</span>
					<h3>Stress testing</h3>
					<p>Run a strategy through a thousand alternative histories instead of the single one that happened.</p>
					<ul>
						<li>Crash and high-volatility regimes with heavy tails and volatility clustering</li>
						<li>Optional spikes and multi-candle flash crashes</li>
						<li>Distributions of drawdown and P&amp;L across seeds, not one equity curve</li>
					</ul>
					<span class="mf-card-link">Stress-testing guide →</span>
				</a>
			</div>
		</div>
	</section>

	<section class="mf-section mf-split">
		<div class="mf-wrap mf-split-inner">
			<div>
				<p class="mf-kicker">Ground truth</p>
				<h2>Every candle knows why it moved</h2>
				<p>
					Markets have hidden states, but real data never tells you which one you're in. MarketForge does. With
					<code>--with-regime</code>, each candle carries the market regime the simulator was actually in: a label
					for supervised learning, an answer key for regime detectors, and a way to score a strategy separately in each
					regime.
				</p>
				<p>
					The regime is shared by every instrument of a market, as in a real sell-off, and it scales volatility and
					drift without changing their long-run levels.
				</p>
				<a class="mf-textlink" href={docs('use-cases/machine-learning/')}>Train a regime classifier →</a>
			</div>
			<div class="mf-table-wrap">
				<table class="mf-table">
					<caption>data["{sample.instrument}"]["{sample.timeframe}"], around the crash in the chart above</caption>
					<thead>
						<tr><th>timestamp</th><th>close</th><th class="mf-hide-sm">volume</th><th class="mf-hide-sm">spread</th><th>regime</th></tr>
					</thead>
					<tbody>
						{excerpt.map((c) => (
							<tr>
								<td>{iso(c[0] as number)}</td>
								<td>{(c[4] as number).toFixed(2)}</td>
								<td class="mf-hide-sm">{(c[5] as number).toFixed(2)}</td>
								<td class="mf-hide-sm">{(c[6] as number).toFixed(4)}</td>
								<td class={`mf-regime-tag r-${c[7]}`}>{c[7]}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	</section>

	<section class="mf-section">
		<div class="mf-wrap mf-split-inner mf-reverse">
			<div>
				<p class="mf-kicker">Realism, measured</p>
				<h2>Validated against real markets, not just eyeballed</h2>
				<p>
					A model trained on unrealistic data learns unrealistic habits. MarketForge's realism is a contract: heavy
					tails, volatility clustering, long memory, the leverage effect, intrabar range and spread behaviour must fall
					inside bands measured on real minute data. Crypto bands come from Binance klines and best bid/ask of seven
					coins.
				</p>
				<p>
					Every instrument is checked across seeds: all 624 checks pass on two-week windows. The validator ships with
					the package, so you can run it on MarketForge output or on your own data.
				</p>
				<a class="mf-textlink" href={docs('guides/validation/')}>How validation works →</a>
			</div>
			<div class="mf-terminal" aria-label="Validation report of the sample above">
				<div class="mf-terminal-bar"><span></span><span></span><span></span><code>marketforge validate</code></div>
				<pre><code><span class="mf-prompt">$</span> marketforge validate --input data/crypto/{sample.instrument}_m1.csv
{validationLines.map((line) => {
	const ok = line.trimStart().startsWith('ok');
	const fail = line.trimStart().startsWith('FAIL');
	return <span class={ok ? 'mf-ok' : fail ? 'mf-fail' : ''}>{line}{'\n'}</span>;
})}</code></pre>
			</div>
		</div>
	</section>

	<section class="mf-section">
		<div class="mf-wrap">
			<header class="mf-section-head">
				<p class="mf-kicker">Engineering</p>
				<h2>Built like infrastructure, not a notebook</h2>
			</header>
			<div class="mf-features">
				<div>
					<h3>Reproducible</h3>
					<p>The seed, market and minute fix every random shock. The same EURUSD comes out whether you generate it alone or with 207 other instruments, at any timeframe or in either format, and CI checks 786 outputs on every commit.</p>
				</div>
				<div>
					<h3>Extendable datasets</h3>
					<p>Every dataset records how it was made. <code>marketforge extend ./data --days 30</code> continues it, and the result is byte-identical to generating the whole range at once.</p>
				</div>
				<div>
					<h3>Real calendars</h3>
					<p>No candles while a market is closed. Gaps come from the price moving during the closure, as they do in reality, and partial candles are never published.</p>
				</div>
				<div>
					<h3>One market, one story</h3>
					<p>Instruments of a market are simulated together: a full correlation matrix, Student-t shocks with shared tail risk, and one regime path.</p>
				</div>
				<div>
					<h3>Fast, bounded memory</h3>
					<p>Compiled Numba kernels stream through the simulation one day at a time. A month of all 208 instruments takes about 6 s, and memory stays flat however long the range.</p>
				</div>
				<div>
					<h3>Your instruments</h3>
					<p>A TOML file changes the start price, volatility, drift, volume, spread or correlations of any instrument, or adds new ones. No fork needed.</p>
				</div>
			</div>
		</div>
	</section>

	<section class="mf-section">
		<div class="mf-wrap mf-split-inner">
			<div>
				<p class="mf-kicker">Python API</p>
				<h2>From seed to tensor in a few lines</h2>
				<p>
					Generate in memory as pandas DataFrames, or stream years to CSV or Parquet. Panels line up every instrument on
					one UTC index, with NaN where a market was closed: no hidden forward-fill.
				</p>
				<a class="mf-textlink" href={docs('guides/python-api/')}>Python API reference →</a>
			</div>
			<div class="mf-code">
				<div class="mf-terminal-bar"><span></span><span></span><span></span><code>train.py</code></div>
				<pre><code><span class="k">import</span> marketforge <span class="k">as</span> mf

<span class="c"># Disjoint seeds: train, validation and test never share a path</span>
splits = {"{"}<span class="s">"train"</span>: <span class="n">range</span>(<span class="n">0</span>, <span class="n">64</span>), <span class="s">"val"</span>: <span class="n">range</span>(<span class="n">64</span>, <span class="n">72</span>), <span class="s">"test"</span>: <span class="n">range</span>(<span class="n">72</span>, <span class="n">80</span>){"}"}

<span class="k">for</span> seed <span class="k">in</span> splits[<span class="s">"train"</span>]:
    data = mf.generate(
        <span class="s">"BTCUSD,ETHUSD,SOLUSD"</span>,
        start=<span class="s">"2024-01-01"</span>, end=<span class="s">"2024-04-01"</span>,
        seed=seed, timeframes=[<span class="s">"m5"</span>],
        include_regime=<span class="n">True</span>, include_spread=<span class="n">True</span>,
    )
    closes = data.panel(<span class="s">"close"</span>, <span class="s">"m5"</span>)      <span class="c"># time × instrument</span>
    labels = data[<span class="s">"BTCUSD"</span>][<span class="s">"m5"</span>][<span class="s">"regime"</span>]  <span class="c"># ground truth</span>
    ...</code></pre>
			</div>
		</div>
	</section>

	<section class="mf-section">
		<div class="mf-wrap">
			<div class="mf-honest">
				<div>
					<p class="mf-kicker">What it is not</p>
					<h2>No alpha in here, by design</h2>
				</div>
				<div>
					<p>
						A model trained only on MarketForge learns MarketForge. The data has realistic statistics, but no
						exploitable edge that carries over to real markets, and instrument symbols are just labels for parameter
						sets. A strategy that makes money on synthetic data has proved that it runs, not that it works.
					</p>
					<p>
						Use MarketForge to build, debug, pre-train, augment and stress-test. Use real data to decide whether
						anything earns money.
					</p>
					<a class="mf-textlink" href={docs('limits/')}>Known limits and simplifications →</a>
				</div>
			</div>
		</div>
	</section>

	<section class="mf-section mf-final">
		<div class="mf-wrap">
			<h2>Generate your first dataset</h2>
			<pre class="mf-final-cmd"><code><span class="mf-prompt">$</span> pip install marketforge
<span class="mf-prompt">$</span> marketforge generate -o ./data --from 2024-01-01 --days 90 --market crypto --with-regime --seed 42</code></pre>
			<div class="mf-cta mf-cta-center">
				<a class="mf-btn mf-btn-primary" href={docs('quick-start/')}>Quick start</a>
				<a class="mf-btn" href="https://github.com/DamienReichhart/MarketForge">Star on GitHub</a>
			</div>
		</div>
	</section>
</Landing>

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(button.dataset.copy ?? '');
				button.textContent = 'Copied';
				setTimeout(() => (button.textContent = 'Copy'), 1500);
			} catch {
				button.textContent = 'Select it';
			}
		});
	}
</script>
